# Copy to .env and fill in. Never commit .env (it is gitignored).
# The same runtime variables go in the Vercel project settings.

# Supabase (new API keys: sb_publishable_… / sb_secret_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only for local scripts: npm run db:push / db:types
SUPABASE_DB_PASSWORD=

# Admin account created by `npm run seed:admin` (local script only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend; defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=
